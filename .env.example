# Supabase Configuration (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Tombol login sosial yang ditampilkan (pisahkan dengan koma): google,facebook,apple
# Pastikan provider yang sama sudah diaktifkan di Supabase -> Authentication -> Providers.
# Isi "none" untuk menyembunyikan semua tombol login sosial.
VITE_AUTH_PROVIDERS=google

# App Configuration
VITE_APP_NAME=Fundly
VITE_APP_URL=https://fundly.id

# Email kontak yang ditampilkan di Kebijakan Privasi & Syarat Layanan (/privacy, /terms)
VITE_SUPPORT_EMAIL=support@fundly.id
